<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UP.App"
             xmlns:local="using:UP"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->


            
    <Application.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush">#FDF8F5</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#C8966E</SolidColorBrush>
        <SolidColorBrush x:Key="AccentSoftBrush">#F0E4DC</SolidColorBrush>
        <SolidColorBrush x:Key="BorderSoftBrush">#E0C8BC</SolidColorBrush>
        <SolidColorBrush x:Key="TextMainBrush">#2D2D2D</SolidColorBrush>
        <SolidColorBrush x:Key="TextMutedBrush">#7A6A6A</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="ContentPage">
            <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI" />
        </Style>

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="CommandBar">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.78" />
        </Style>

        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="Padding" Value="0" />
        </Style>
    </Application.Styles>
    
</Application>
