<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UP.Views.EditBookAuthorPage">
    <Grid Background="#FDF8F5">
         <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
           
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1" BorderBrush="#E0C8BC" Background="White"
                Margin="10,10,10,5" CornerRadius="12" Padding="16"
                BoxShadow="0 12 30 0 #10000000">
            <StackPanel Orientation="Horizontal"  >
            <StackPanel Width="300" HorizontalAlignment="Left" >
            <TextBox Text="{Binding CurrentBook.Name}" Width="220" FontSize="14" HorizontalAlignment="Center"
                       Foreground="#C8966E" LetterSpacing="3" Margin="0,0,0,6"/>
            <TextBox Text="{Binding CurrentBook.AuthorNavigation.fio}" Width="220" FontSize="14" HorizontalAlignment="Center"
                       Foreground="#C8966E" LetterSpacing="3" Margin="0,0,0,6"/>
            <TextBox Text="{Binding CurrentBook.Description}" Width="220" Height="58" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Foreground="#C8966E"  Margin="0,0,0,6"/>
           
                
            </StackPanel>
                <StackPanel>
                    <ListBox ItemsSource="{Binding CurrentBook.BookGenres}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding Genre.Genre1}"
                                               Foreground="#5A4A4A" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel>
                    <ListBox ItemsSource="{Binding AllGenres}"
                             SelectedItem="{Binding CurrentGenre}"
                             Background="Transparent" BorderThickness="0"
                             Height="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding Genre1}"
                                               Foreground="#5A4A4A" FontSize="13"/>
                                    <Button Content="Добавить" 
                                            Background="#C8966E" Foreground="White"
                                            CornerRadius="6" Padding="10,5" FontSize="13" Margin="0,10,0,0"
                                            Command="{Binding DataContext.AddGenreCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                    />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                    <Button Content="Сохранить"  Command="{Binding SaveClickCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E0C8BC" BorderThickness="1"
                Margin="10,5,10,10" CornerRadius="12" Padding="18"
                BoxShadow="0 12 30 0 #10000000">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBox Text="{Binding CurrentBook.Content}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

       
    </Grid>
</ContentPage>
